# ── LiteLLM Proxy (SAP AI Core) ───────────────────────────────────────────────
LITELLM_BASE_URL=http://localhost:6655/litellm/v1
LITELLM_API_KEY=your-litellm-api-key
LITELLM_MODEL=anthropic--claude-sonnet-4-6

# ── Excel file (Sonia's standard format) ──────────────────────────────────────
# Two-sheet workbook: "SUM DMO" (tasks) + "SAP User Access List" (people & roles)
EXCEL_FILE_PATH=Cutover Plan Test.xlsx

# ── Teams Incoming Webhook (Maria's notification channel) ─────────────────────
# How to get: Teams channel → ··· → Connectors (or Workflows) → Incoming Webhook → Configure → copy URL
TEAMS_WEBHOOK_URL=https://sap.webhook.office.com/webhookb2/your-webhook-url-here

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
# AGENT_PUBLIC_URL=http://localhost:5000/
